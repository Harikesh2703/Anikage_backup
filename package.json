{
  "name": "ani-cli",
  "version": "4.10.4",
  "description": "Anikage Desktop - Premium Anime Streaming",
  "main": "electron-main.mjs",
  "bin": {
    "ani-cli": "./bin/ani-cli.js"
  },
  "scripts": {
    "start": "node bin/ani-cli.js",
    "server": "node server/index.mjs",
    "frontend": "cd frontend/emerald-stream-main && npm run dev",
    "build:frontend": "cd frontend/emerald-stream-main && npm run build",
    "desktop": "concurrently \"npm run frontend\" \"electron .\"",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "anime",
    "cli",
    "streaming",
    "allmanga",
    "video"
  ],
  "author": "ani-cli contributors",
  "license": "GPL-3.0",
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "inquirer": "^8.2.5",
    "ora": "^5.4.1",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pystardust/ani-cli.git"
  },
 "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.anikage.app",
    "productName": "Anikage",
    "files": [
      "**/*",
      "electron-main.mjs"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
