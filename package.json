{
  "name": "anikage",
  "version": "1.0.0",
  "description": "Anikage Desktop - Premium Anime Streaming",
  "main": "electron-main.mjs",
  "bin": {
    "anikage": "./bin/anikage.js"
  },
  "scripts": {
    "start": "node bin/anikage.js",
    "server": "node server/index.mjs",
    "frontend": "cd frontend/emerald-stream-main && npm run dev",
    "build:frontend": "cd frontend/emerald-stream-main && npm run build",
    "desktop": "concurrently \"npm run frontend\" \"electron . --no-sandbox\"",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "anime",
    "cli",
    "streaming",
    "allmanga",
    "video"
  ],
  "author": "Anikage Team",
  "license": "GPL-3.0",
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "inquirer": "^8.2.5",
    "ora": "^5.4.1",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Harikesh2703/Anikage_backup.git"
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.anikage.app",
    "productName": "Anikage",
    "icon": "icon256.ico",
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "src/**/*",
      "node_modules/**/*"
    ],
    "files": [
      "**/*",
      "!dist_electron",
      "!frontend/emerald-stream-main/src",
      "!frontend/emerald-stream-main/node_modules",
      "frontend/emerald-stream-main/dist/**/*"
    ],
    "directories": {
      "output": "dist_electron"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "Anikage",
      "category": "Video",
      "maintainer": "HERWIN VG <contact@anikage.com>",
      "synopsis": "Premium Anime Streaming Desktop Client"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Anikage_Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Anikage"
    }
  }
}